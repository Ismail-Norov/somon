# SQLite (default, no Docker needed):
DATABASE_URL="file:./dev.db"

# PostgreSQL (optional, with docker compose):
# DATABASE_URL="postgresql://somon:somon@localhost:5432/somon?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:3000"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=20
COOKIE_SECURE=false

# Lesson reminders are sent this many hours before the start (checked every 5 minutes).
LESSON_REMINDER_HOURS=3
# Timezone for times in notification texts, e.g. "Asia/Dushanbe". Empty = server timezone.
APP_TIMEZONE=
